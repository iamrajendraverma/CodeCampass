# Required: your Anthropic API key for the LLM-powered client.
ANTHROPIC_API_KEY=sk-ant-...

# GitHub access. Two ways to authenticate — pick one:
#
# 1) Interactive login (recommended for private repos): register a GitHub OAuth
#    App with "Enable Device Flow" checked, then set its client_id here. On
#    startup the client shows a code + URL to approve in your browser, and the
#    resulting token can see YOUR private repositories.
#      https://github.com/settings/developers  →  New OAuth App
GITHUB_CLIENT_ID=

# 2) Or provide a token directly (skips the login prompt). Use a Personal Access
#    Token with 'repo' scope to include private repos; no scope = public only.
#      https://github.com/settings/tokens
GITHUB_TOKEN=

# Jira Cloud access (enables the Jira status tools). All three are required.
# JIRA_EMAIL is the Atlassian account that owns the API token; JIRA_API_TOKEN is
# created (once) at https://id.atlassian.com/manage-profile/security/api-tokens
# Cloud uses Basic auth with email:token — not your password.
JIRA_BASE_URL=https://bechprep.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
